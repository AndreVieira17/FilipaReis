# Copiar este ficheiro para .env.local e preencher com os valores reais.
# NUNCA fazer commit de .env.local (já está no .gitignore via .env*.local).

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço (bypassa RLS) — usar apenas em código server-side (ex: webhook do Stripe)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers > API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Developers > Webhooks > chave assinada do endpoint (gerada na Fase 3)
STRIPE_WEBHOOK_SECRET=
